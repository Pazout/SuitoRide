<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.2.5</Version>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\SuitoRide.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup><Content Include="map\**"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content></ItemGroup>
  <ItemGroup><Resource Include="Assets\SuitoRide.ico" /></ItemGroup>
  <ItemGroup><Compile Remove="SpolecnaJizda.Server\**\*.cs" /><None Remove="SpolecnaJizda.Server\**" /><Content Remove="SpolecnaJizda.Server\**" /></ItemGroup>
</Project>
