<Application x:Class="SuitoRide.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SuitoRide"
             StartupUri="MainWindow.xaml" ThemeMode="Dark">
    <Application.Resources>
      <SolidColorBrush x:Key="SuitoWindowBackground" Color="#101b25"/>
      <SolidColorBrush x:Key="SuitoWindowForeground" Color="#eaf1f5"/>
      <Style x:Key="HighContrastButton" TargetType="Button">
        <Setter Property="Background" Value="#12382f"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#84c7b5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Tag" Value="#1b483c"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#0b2922"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Background" Value="#384951"/><Setter Property="Foreground" Value="#d1dbd9"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#80918e"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource HighContrastButton}"/>
    </Application.Resources>
</Application>
