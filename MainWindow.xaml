<Window x:Class="SuitoRide.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SuitoRide" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Icon="Assets/SuitoRide.ico" Title="Suito Ride" Height="820" Width="1200" MinWidth="780" MinHeight="580" Background="{StaticResource SuitoWindowBackground}" Foreground="{StaticResource SuitoWindowForeground}">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource HighContrastButton}"><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,0,6,4"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="SetupPanel" Grid.Row="0" Margin="0,0,0,4">
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="SUITO RIDE" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,4"/>
          <Button Content="{local:Ui 'Historie tréninků'}" Click="ShowHistory"/>
          <Button Content="{local:Ui 'Cache a panorama'}" Click="ShowMapSettings"/>
          <Button Content="{local:Ui 'Zkontrolovat aktualizace'}" Click="CheckForUpdates"/>
          <Button x:Name="RetrySaveButton" Content="{local:Ui 'Uložit čekající jízdu'}" Click="RetrySaveRide" Visibility="Collapsed"/>
        </StackPanel>
      </Viewbox>
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <Button Content="{local:Ui 'Vybrat složku tras'}" Click="ChooseFolder"/>
          <Button Content="{local:Ui 'Obnovit katalog'}" Click="RefreshCatalog"/>
          <ComboBox x:Name="Catalog" Width="300" Margin="0,0,6,4" HorizontalContentAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <DockPanel ToolTip="{Binding File.Name}">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}" FontWeight="SemiBold" Margin="8,0,4,0" ToolTip="{local:Ui 'Počet dokončených jízd'}"/>
                  <TextBlock Text="{Binding File.Name}"/>
                </DockPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="{local:Ui 'Načíst z katalogu'}" Click="LoadCatalog"/>
          <Button Content="{local:Ui 'Načíst GPX'}" Click="LoadRoute"/>
          <Button Content="{local:Ui 'Upravit trasu'}" Click="EditRoute"/>
        </StackPanel>
      </Viewbox>
      <Grid Margin="0,0,0,3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="CatalogInfo" Grid.Column="0" Foreground="#99b2bf" Text="{local:Ui 'Katalog: složka zatím není vybrána.'}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="RouteInfo" Grid.Column="1" Foreground="#99b2bf" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </Grid>
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <Button Content="{local:Ui 'Vyhledat trenažér'}" Click="Scan"/>
          <ComboBox x:Name="Devices" DisplayMemberPath="Name" Width="210" Margin="0,0,6,4"/>
          <Button Content="{local:Ui 'Připojit vybraný'}" Click="Connect"/>
          <Button Content="{local:Ui 'Odpojit'}" Click="Disconnect"/>
          <TextBlock x:Name="RouteName" Text="{local:Ui 'Zatím není načtená žádná trasa'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,4" MaxWidth="300" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
      </Viewbox>
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{local:Ui 'PANORAMA'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,4"/>
          <ComboBox x:Name="PanoramaProvider" Width="145" SelectedIndex="0" SelectionChanged="PanoramaProviderChanged" Margin="0,0,6,4"><ComboBoxItem Content="Mapy.com"/><ComboBoxItem Content="Google Street View"/></ComboBox>
          <PasswordBox x:Name="GoogleKey" Width="145" Margin="0,0,6,4" ToolTip="{local:Ui 'API klíč panoramatu'}"/>
          <Button Content="{local:Ui 'Zapnout'}" Click="EnableStreetView"/><Button Content="{local:Ui 'Vypnout'}" Click="DisableStreetView"/><Button Content="{local:Ui 'Klíč Google 3D'}" Click="ConfigureGoogle3D"/><Button Content="{local:Ui 'Odstranit klíč'}" Click="ForgetPanoramaKey"/>
        </StackPanel>
      </Viewbox>
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="KeyStatus" Grid.Column="0" Foreground="#99b2bf" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="StreetStatus" Grid.Column="1" Foreground="#99b2bf" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="MapStatus" Grid.Column="2" Text="{local:Ui 'Načítám mapu…'}" Foreground="#99b2bf" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </Grid>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel x:Name="MapControls" Grid.Row="0">
        <Button Content="{local:Ui 'Zobrazit celou trasu'}" ToolTip="{local:Ui 'Platí pro hlavní mapu'}" Click="FitMap"/>
        <Button Content="{local:Ui 'Sledovat jezdce'}" ToolTip="{local:Ui 'Platí pro hlavní mapu'}" Click="FollowRider"/><Button Content="{local:Ui 'Navigační pohled'}" Click="ShowNavigation" ToolTip="{local:Ui 'Nakloněná mapa ve směru jízdy'}"/><Button Content="Google 3D" Click="ShowGoogle3D" ToolTip="{local:Ui 'Letecký 3D pohled ve směru jízdy'}"/><Button Content="{local:Ui 'Panorama'}" Click="ShowPanorama"/><Button Content="{local:Ui 'Společná jízda'}" Click="OpenSharedRide"/>
        <CheckBox x:Name="RotateMap" IsChecked="True" Content="{local:Ui 'Mapa ve směru jízdy'}" ToolTip="{local:Ui 'Platí pro hlavní mapu'}" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" Checked="SetMapRotation" Unchecked="SetMapRotation"/>
      </WrapPanel>
      <wv:WebView2 x:Name="MapView" Grid.Row="1" MinHeight="100" Margin="0,0,0,6"/>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Canvas x:Name="Profile" Grid.Row="0" Height="85" Background="#1c2c38" SizeChanged="DrawProfile" ClipToBounds="True" ToolTip="{local:Ui 'Barva sklonu: tmavě modrá pod −3 %, světle modrá klesání, zelená 0–3 %, žlutá 3–6 %, oranžová 6–10 %, červená nad 10 %.'}"/>
      <ProgressBar x:Name="Progress" Grid.Row="1" Height="6" Margin="0,4,0,6" Maximum="100"/>
    </Grid>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <UniformGrid Columns="5">
          <StackPanel><TextBlock Text="{local:Ui 'VÝKON'}" Foreground="#99b2bf"/><TextBlock x:Name="Power" Text="— W" FontSize="20"/></StackPanel>
          <StackPanel><TextBlock Text="{local:Ui 'RYCHLOST'}" Foreground="#99b2bf"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="Speed" Text="— km/h" FontSize="20"/><TextBlock x:Name="SpeedTrend" FontSize="19" Margin="6,0,0,0" ToolTip="{local:Ui 'Porovnání s průměrnou rychlostí jízdy'}"/></StackPanel></StackPanel>
          <StackPanel><TextBlock Text="{local:Ui 'KADENCE'}" Foreground="#99b2bf"/><TextBlock x:Name="Cadence" Text="{local:Ui '— ot/min'}" FontSize="20"/></StackPanel>
          <StackPanel><TextBlock Text="{local:Ui 'ČAS JÍZDY'}" Foreground="#99b2bf"/><TextBlock x:Name="Elapsed" Text="00:00:00" FontSize="20"/></StackPanel><Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><StackPanel><TextBlock Text="{local:Ui 'SKLON · DALŠÍCH 500 m'}" Foreground="#99b2bf"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="Grade" Text="— %" FontSize="20" VerticalAlignment="Center"/><Canvas x:Name="ZoomProfile" Width="110" Height="44" Background="#1c2c38" Margin="8,0,0,0" ClipToBounds="True" SizeChanged="DrawProfile" ToolTip="{local:Ui 'Profil následujících 500 metrů; bílá čára označuje aktuální polohu.'}"/></StackPanel></StackPanel></Viewbox>
        </UniformGrid>
        <TextBlock x:Name="RideInfo" Text="{local:Ui 'Pro skutečnou jízdu připojte trenažér.'}" Foreground="#99b2bf" Margin="0,2,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="Status" Text="{local:Ui 'Načtěte trasu a vyhledejte trenažér.'}" Foreground="#9ed4c7" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"><Button x:Name="StartButton" Content="{local:Ui '▶  Zahájit jízdu'}" Background="#07518a" Tag="#0866a7" FontWeight="SemiBold" Click="StartRide"/><Button x:Name="DemoButton" Content="{local:Ui '▷  Ukázková jízda'}" Background="#59428a" Tag="#6b51a2" FontWeight="SemiBold" Click="StartDemo"/><Button x:Name="StopButton" Content="{local:Ui '■  Zastavit'}" Background="#8a2734" Tag="#a33140" FontWeight="SemiBold" Click="StopRide" Visibility="Collapsed"/></StackPanel>
    </Grid>
  </Grid>
</Window>