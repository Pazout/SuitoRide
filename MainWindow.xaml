<Window x:Class="SuitoRide.MainWindow" PreviewKeyDown="ProfilePreviewKeyDown" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SuitoRide" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Icon="Assets/SuitoRide.ico" Title="Suito Ride" Height="820" Width="1200" MinWidth="780" MinHeight="400" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource SuitoWindowBackground}" Foreground="{StaticResource SuitoWindowForeground}">
  <Window.Resources>
    <Style TargetType="local:ActionButton" BasedOn="{StaticResource HighContrastButton}"><Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="0,0,6,4"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  </Window.Resources>
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="4*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="28" MaxHeight="85"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel x:Name="SetupPanel" Grid.Row="0" Margin="0,0,0,4">
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="SUITO RIDE" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,4"/>
          <local:ActionButton Content="{local:Ui 'Historie tréninků', Prompt=True}" Icon="{x:Static local:ButtonIcons.History}" Click="ShowHistory"/>
          <local:ActionButton Content="{local:Ui 'Nastavení', Prompt=True}" Icon="{x:Static local:ButtonIcons.Settings}" Click="ShowMapSettings"/>
          <local:ActionButton Content="{local:Ui 'Společná jízda', Prompt=True}" Icon="{x:Static local:ButtonIcons.Group}" Click="OpenSharedRide"/>
          <local:ActionButton Content="{local:Ui 'Referenční jízda', Prompt=True}" Icon="{x:Static local:ButtonIcons.Follow}" Click="OpenReferenceRide"/>
          <local:ActionButton x:Name="SavedReferenceButton" Content="{local:Ui 'Použít uloženou referenci'}" Icon="{x:Static local:ButtonIcons.Check}" Click="UseSavedReferenceRide" Visibility="Collapsed"/>
          <local:ActionButton Content="{local:Ui 'Zkontrolovat aktualizace', Prompt=True}" Icon="{x:Static local:ButtonIcons.Update}" Click="CheckForUpdates"/>
          <local:ActionButton x:Name="RetrySaveButton" Content="{local:Ui 'Uložit čekající jízdu'}" Icon="{x:Static local:ButtonIcons.Save}" Click="RetrySaveRide" Visibility="Collapsed"/>
        </StackPanel>
      </Viewbox>
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <local:ActionButton Content="{local:Ui 'Vybrat složku tras', Prompt=True}" Icon="{x:Static local:ButtonIcons.Folder}" Click="ChooseFolder"/>
          <local:ActionButton Content="{local:Ui 'Dropbox', Prompt=True}" Icon="{x:Static local:ButtonIcons.Dropbox}" Click="ShowDropboxSettings" ToolTip="{local:Ui 'Složky Dropboxu'}"/>
          <local:ActionButton Content="{local:Ui 'Obnovit katalog'}" Icon="{x:Static local:ButtonIcons.Refresh}" Click="RefreshCatalog"/>
          <ComboBox x:Name="Catalog" SelectionChanged="CatalogSelectionChanged" Width="300" Margin="0,0,6,4" HorizontalContentAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <DockPanel ToolTip="{Binding File.Name}">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}" FontWeight="SemiBold" Margin="8,0,4,0" ToolTip="{local:Ui 'Počet dokončených jízd'}"/>
                  <TextBlock Text="{Binding File.Name}"/>
                </DockPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <local:ActionButton Content="{local:Ui 'Načíst GPX', Prompt=True}" Icon="{x:Static local:ButtonIcons.Route}" Click="LoadRoute"/>
          <local:ActionButton Content="WTracks" Icon="{x:Static local:ButtonIcons.External}" Click="OpenWTracks" ToolTip="{local:Ui 'Upravit GPX ve WTracks v prohlížeči'}"/>
          <local:ActionButton Content="{local:Ui 'Upravit trasu', Prompt=True}" Icon="{x:Static local:ButtonIcons.Edit}" Click="EditRoute"/>
        </StackPanel>
      </Viewbox>
      <Grid Margin="0,0,0,3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="CatalogInfo" Grid.Column="0" Foreground="#99b2bf" Text="{local:Ui 'Katalog: složka zatím není vybrána.'}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="RouteInfo" Grid.Column="1" Foreground="#99b2bf" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </Grid>
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="RouteName" Text="{local:Ui 'Zatím není načtená žádná trasa'}" FontWeight="SemiBold" Grid.Column="0" Margin="0,0,8,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="StreetStatus" Grid.Column="1" Margin="0,0,8,0" Foreground="#99b2bf" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="MapStatus" Grid.Column="2" Text="{local:Ui 'Načítám mapu…'}" Foreground="#99b2bf" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </Grid>
    </StackPanel>
    <WrapPanel x:Name="MapControls" Grid.Row="1">
      <local:ActionButton x:Name="TrainerButton" Content="{local:Ui 'Trenažér', Prompt=True}" Icon="{x:Static local:ButtonIcons.Bike}" Background="#12485A" Tag="#185D72" Click="OpenTrainer"/>
      <local:ActionButton x:Name="HeartRateButton" Content="{local:Ui 'Hrudní pás', Prompt=True}" Icon="{x:Static local:ButtonIcons.Heart}" Background="#722D49" Tag="#8D3859" Click="OpenHeartRate"/>
      <local:ActionButton x:Name="SramButton" Content="{local:Ui 'SRAM AXS', Prompt=True}" Icon="{x:Static local:ButtonIcons.Battery}" Click="OpenSram"/>
      <local:ActionButton Content="{local:Ui 'Zobrazit celou trasu'}" Icon="{x:Static local:ButtonIcons.Fit}" ToolTip="{local:Ui 'Platí pro hlavní mapu'}" Click="FitMap"/>
      <local:ActionButton Content="{local:Ui 'Sledovat jezdce'}" Icon="{x:Static local:ButtonIcons.Follow}" ToolTip="{local:Ui 'Platí pro hlavní mapu'}" Click="FollowRider"/>
      <local:ActionButton Content="{local:Ui 'Navigační pohled'}" Icon="{x:Static local:ButtonIcons.Navigate}" Click="ShowNavigation" ToolTip="{local:Ui 'Nakloněná mapa ve směru jízdy'}"/>
      <local:ActionButton Content="{local:Ui 'Google 3D', Prompt=True}" Icon="{x:Static local:ButtonIcons.Cube}" Click="ShowGoogle3D" ToolTip="{local:Ui 'Letecký 3D pohled ve směru jízdy'}"/>
      <local:ActionButton Content="{local:Ui 'Panorama'}" Icon="{x:Static local:ButtonIcons.Panorama}" Click="ShowPanorama"/>
      <ComboBox x:Name="PanoramaProvider" Width="154" Margin="0,0,6,4" SelectedIndex="0"
                SelectedValuePath="Tag" SelectionChanged="PanoramaProviderChanged" ToolTip="{local:Ui 'Poskytovatel panoramatu'}">
        <ComboBoxItem Tag="off" Content="{local:Ui 'Panorama vypnuto'}"/>
        <ComboBoxItem Tag="mapy" Content="Mapy.com"/>
        <ComboBoxItem Tag="google" Content="Google Street View"/>
        <ComboBoxItem Tag="mapillary" Content="Mapillary"/>
      </ComboBox>
      <CheckBox x:Name="RotateMap" IsChecked="True" Content="{local:Ui 'Mapa ve směru jízdy'}" ToolTip="{local:Ui 'Platí pro hlavní mapu'}" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" Checked="SetMapRotation" Unchecked="SetMapRotation"/>
    </WrapPanel>
    <wv:WebView2 x:Name="MapView" Grid.Row="2" Margin="0,0,0,6"/>
    <Viewbox Grid.Row="3" Margin="0,0,0,3" StretchDirection="DownOnly" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{local:Ui 'Sklon trasy'}" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <ItemsControl x:Name="GradeLegend" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <Border Background="{Binding Color}" Width="10" Height="10" CornerRadius="2" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Label}" FontSize="12"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
          <Line x:Name="SpeedLegendLine" X1="0" X2="18" Y1="1" Y2="1" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock x:Name="SpeedLegendLabel" FontSize="12"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Line x:Name="HeartRateLegendLine" X1="0" X2="18" Y1="1" Y2="1" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock x:Name="HeartRateLegendLabel" FontSize="12"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10,0,10,0" VerticalAlignment="Center">
          <Line x:Name="CadenceLegendLine" X1="0" X2="18" Y1="1" Y2="1" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock x:Name="CadenceLegendLabel" FontSize="12"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Line x:Name="PowerLegendLine" X1="0" X2="18" Y1="1" Y2="1" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock x:Name="PowerLegendLabel" FontSize="12"/>
        </StackPanel>
      </StackPanel>
    </Viewbox>
    <Canvas x:Name="Profile" Grid.Row="4" Background="#1c2c38" SizeChanged="DrawProfile" ClipToBounds="True" Focusable="True"
            MouseLeftButtonDown="BeginProfilePreview" MouseMove="MoveProfilePreview" MouseLeftButtonUp="FinishProfilePreview"
            LostMouseCapture="RefreshPreviewPanorama"
            ToolTip="{local:Ui 'Mimo jízdu klikni nebo táhni po profilu. Dvojklik otevře úpravu trasy. Náhled ukončíš klávesou Esc.'}"/>
    <ProgressBar x:Name="Progress" Grid.Row="5" Height="6" Margin="0,4,0,6" Maximum="100"/>
    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <UniformGrid Columns="6">
          <StackPanel>
            <TextBlock Text="{local:Ui 'VÝKON'}" Foreground="#99b2bf"/>
            <TextBlock x:Name="Power" Text="— W" FontSize="20"/>
            <TextBlock x:Name="TrainerActivity" Visibility="Collapsed" Foreground="#F5BE5B" TextWrapping="Wrap" TextTrimming="None"/>
          </StackPanel>
          <StackPanel><TextBlock Text="{local:Ui 'RYCHLOST'}" Foreground="#99b2bf"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="Speed" Text="— km/h" FontSize="20" Background="Transparent" PreviewMouseDown="ChangeDemoSpeed"/><TextBlock x:Name="SpeedTrend" FontSize="19" Margin="6,0,0,0" ToolTip="{local:Ui 'Porovnání s průměrnou rychlostí jízdy'}"/></StackPanel></StackPanel>
          <StackPanel><TextBlock Text="{local:Ui 'KADENCE'}" Foreground="#99b2bf"/><TextBlock x:Name="Cadence" Text="{local:Ui '— ot/min'}" FontSize="20"/></StackPanel>
          <StackPanel>
            <TextBlock Text="{local:Ui 'TEP'}" Foreground="#99b2bf"/>
            <TextBlock x:Name="HeartRate" Text="— bpm" FontSize="20" ToolTip="{Binding ToolTip, ElementName=HeartRateButton}"/>
            <TextBlock x:Name="HeartRateActivity" Visibility="Collapsed" Foreground="#F5BE5B" TextWrapping="Wrap" TextTrimming="None"/>
          </StackPanel>
          <StackPanel><TextBlock Text="{local:Ui 'ČAS JÍZDY'}" Foreground="#99b2bf"/><TextBlock x:Name="Elapsed" Text="00:00:00" FontSize="20"/></StackPanel>
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock x:Name="ZoomProfileLabel" Foreground="#99b2bf"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Grade" Text="— %" FontSize="20" VerticalAlignment="Center"/>
                <Button Click="ChangeZoomProfileRange" Padding="0" Margin="8,0,0,0" Background="#1c2c38"
                        AutomationProperties.Name="{Binding Text, ElementName=ZoomProfileLabel}"
                        ToolTip="{local:Ui 'Kliknutím změň dosah profilu. Bílá čára označuje aktuální polohu.'}">
                  <Canvas x:Name="ZoomProfile" Width="108" Height="42" ClipToBounds="True" SizeChanged="DrawProfile"/>
                </Button>
              </StackPanel>
            </StackPanel>
          </Viewbox>
        </UniformGrid>
        <DockPanel Margin="0,2,0,0">
          <TextBlock x:Name="ReferenceStatus" DockPanel.Dock="Right" MaxWidth="220" Margin="12,0,0,0" FontWeight="SemiBold" Visibility="Collapsed"/>
          <TextBlock x:Name="RideInfo" Text="{local:Ui 'Pro skutečnou jízdu připojte trenažér.'}" Foreground="#99b2bf" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </DockPanel>
        <DockPanel>
          <TextBlock x:Name="SramBatteryStatus" DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="#9ed4c7" Visibility="Collapsed"/>
          <TextBlock x:Name="Status" Text="{local:Ui 'Načtěte trasu a vyhledejte trenažér.'}" Foreground="#9ed4c7" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </DockPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
        <local:ActionButton x:Name="StartButton" Content="{local:Ui 'Zahájit jízdu', Prompt=True}" Icon="{x:Static local:ButtonIcons.Play}" Background="#07518a" Tag="#0866a7" FontWeight="SemiBold" Click="StartRide"/>
        <local:ActionButton x:Name="DemoButton" Content="{local:Ui 'Ukázková jízda', Prompt=True}" Icon="{x:Static local:ButtonIcons.Demo}" Background="#59428a" Tag="#6b51a2" FontWeight="SemiBold" Click="StartDemo"/>
        <local:ActionButton x:Name="StopButton" Content="{local:Ui 'Zastavit'}" Icon="{x:Static local:ButtonIcons.Stop}" Background="#8a2734" Tag="#a33140" FontWeight="SemiBold" Click="StopRide" Visibility="Collapsed"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>